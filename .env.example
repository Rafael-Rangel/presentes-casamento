# --- Supabase (obrigatório) ---
# No dashboard aparece algo como:
#   https://SEU_REF.supabase.co/rest/v1/
# Em .env usa só a BASE (sem /rest/v1/):
#   NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API Keys:
#   "Publishable" → NEXT_PUBLIC_SUPABASE_ANON_KEY (sb_publishable_… ou JWT anon legacy)
#   "Secret" (default) → SUPABASE_SERVICE_ROLE_KEY (sb_secret_… ou JWT service_role legacy)
# Nunca uses a secret no browser nem em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CLI Supabase (opcional) ---
# Palavra-passe da BASE Postgres (Settings → Database → “Database password”) —
# NÃO uses os três pontos “...”: cola a password real ou repõe no dashboard.
# Não confundir com anon / service_role / JWT.
# SUPABASE_DB_PASSWORD=
# Para script: SUPABASE_PROJECT_REF=abcdefgh  +  SUPABASE_DB_PASSWORD  →  bash scripts/supabase-link-push.sh
#
# Fluxo típico (projeto NOVO ou sem schema aplicado): npx supabase login
# → npx supabase link --project-ref SEU_REF --password "$SUPABASE_DB_PASSWORD"
# → npm run db:push
#
# Ou SQL único manual: npm run db:remote:schema  (equivale ao ficheiro schema.sql)
# Mock: npm run db:remote:seed

# --- DATABASE_URL (automação local: npm run db:sync / npm run db:verify) ---
# Tem de ser a connection string Postgres (começa por postgresql:// ou postgres://),
# em Settings → Database → Connection string → URI (Session ou Direct).
# NÃO uses a URL HTTP do projeto nem .../rest/v1/ — isso não é Postgres.
# Colar a password real; caracteres especiais na password devem estar percent-encoded na URI.
# Nunca commits esta linha preenchida (usa só .env.local).
# DATABASE_URL=
#
# Alternativa sem colar a URI completa: o mesmo host que em `supabase link`:
# SUPABASE_PROJECT_REF=SEU_REF_DO_DASHBOARD
# SUPABASE_DB_PASSWORD=
# `db:sync` / `db:verify` montam postgresql://postgres:***@db.<ref>.supabase.co:5432/postgres
# (se DATABASE_URL estiver vazio ou for URL HTTP por engano, usa estes dois).
#
# `npm run db:sync` aplica supabase/schema.sql e depois seed_mock_demo.sql — ideal para projeto
# novo / BD vazia. Se o schema já existe, usa só mock: `npm run db:seed` (ou `db:remote:seed` com link).

# URL pública do site (magic link, /auth/callback, emails, OG). Em dev: http://localhost:3000
# Produção (ex.): https://casamento-rafael-adrielly.netlify.app — deve coincidir com o Site URL no Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data mostrada na home / convite (texto livre)
NEXT_PUBLIC_WEDDING_DATE=12 de dezembro de 2026

# Painel noivos (senha partilhada pelos dois; não é utilizador Supabase)
# Em produção usa pelo menos 12 caracteres; `npm run deploy:check-env:production` avisa se for fraca.
ADMIN_PASSWORD=
# Segredo para assinar o cookie de sessão do admin (mín. 16 caracteres aleatórios)
ADMIN_SESSION_SECRET=

# Cron (Netlify: funções agendadas chamam /api/cron/* com Authorization: Bearer CRON_SECRET).
# - expire-reservations (hora a hora)
# - gift-reminders (diário — só quem tem marketing_opt_in e zero reservas; Gmail tem limite diário baixo)
CRON_SECRET=

# E-mail transacional (opcional — Gmail com "palavra-passe de app")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Casamento

# Web Push (notificações no telemóvel — HTTPS em produção)
# Gera par: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # chave pública (browser)
# VAPID_PRIVATE_KEY=              # só servidor / Netlify — nunca NEXT_PUBLIC_
# Opcional contacto para VAPID (fallback mailto nos envios):
# VAPID_SUBJECT=mailto:casamento@exemplo.com

# =============================================================================
# NETLIFY — Site configuration → Environment variables
#
# Cria/edita cada variável no painel (mesmo nome que aqui). Valores = iguais ao teu
# .env.local de trabalho, exceto SUPABASE_PROJECT_REF / DATABASE_URL (só máquina local).
#
# Prioridade netlify.toml vs painel:
#   Em [context.production.environment] do netlify.toml podes ter NEXT_PUBLIC_SITE_URL.
#   Se a mesma chave existir no painel, o valor do painel ganha — evita duplicar sem querer.
#
# Lista para colar no Netlify (produção):
#   1. NEXT_PUBLIC_SUPABASE_URL
#   2. NEXT_PUBLIC_SUPABASE_ANON_KEY
#   3. SUPABASE_SERVICE_ROLE_KEY  (nunca NEXT_PUBLIC_*)
#   4. NEXT_PUBLIC_SITE_URL       (https://… domínio final; ou omite se confias só no netlify.toml)
#   5. ADMIN_PASSWORD
#   6. ADMIN_SESSION_SECRET       (mín. 16 caracteres)
#   7. CRON_SECRET                (igual ao .env.local — obrigatório para crons horário/diário)
#   8. SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_FROM, EMAIL_FROM_NAME
#   9. NEXT_PUBLIC_WEDDING_DATE   (opcional)
#  10. NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY — Web Push (opcional)
#
# Validação antes do deploy:
#   npm run deploy:check-env
#
# Validação “como produção” (https + senha forte), sem mudares o localhost no .env.local:
#   cp .env.production.example .env.production.local   # primeira vez
#   edita .env.production.local → NEXT_PUBLIC_SITE_URL=https://teu-dominio…
#   npm run deploy:check-env:production
# =============================================================================

# =============================================================================
# SUPABASE AUTH — Authentication → URL Configuration
#
# Dashboard → Authentication → URL configuration (ou “Sign In / Providers” → URLs).
#
# Site URL (campo único no topo):
#   → URL pública final do site, ex.: https://casamento-rafael-adrielly.netlify.app
#   → Deve coincidir com NEXT_PUBLIC_SITE_URL em produção.
#
# Redirect URLs (lista — adiciona todas as que precisares):
#   https://TEU_DOMINIO/auth/callback
#   http://localhost:3000/auth/callback
#
# Sem isto: magic link, troca de código em /auth/callback e redirects falham ou vão para outro host.
# =============================================================================

# =============================================================================
# SEGURANÇA E ROTAÇÃO
#
# - `npm run generate-secrets` → ADMIN_SESSION_SECRET, CRON_SECRET e sugestão de ADMIN_PASSWORD.
# - Gmail SMTP: usa “palavra-passe de app”. Se copiaste essa palavra para chats ou commits,
#   revoga-a na Conta Google → Segurança → Palavras-passe de app → gera nova → atualiza Netlify + .env.local.
# - ADMIN_PASSWORD em produção: ≥12 caracteres (o comando deploy:check-env:production valida).
# - Nunca commits ficheiros .env*, exceto este .env.example e .env.production.example (templates).
# =============================================================================

# =============================================================================
# CRONS — verificação manual após deploy
#
# Netlify chama /api/cron/* com Authorization: Bearer CRON_SECRET (funções em netlify/functions/).
#
# Testar contra o site já deployado ou contra dev local:
#   BASE_URL=https://teu-site.netlify.app npm run cron:smoke
#   BASE_URL=http://localhost:3000 npm run cron:smoke
#
# Só lembretes (se quiseres isolar):
#   npm run cron:smoke:reminders-only
#
# A RPC `run_expire_stale_reservations` deve existir na BD (schema.sql / migrações).
# =============================================================================
