{
  "name": "presentes-casamento",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:photos": "node scripts/copy-couple-photos.mjs",
    "prebuild": "npm run copy:photos",
    "dev": "npm run copy:photos && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "supabase": "supabase",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:sync": "node scripts/db-sync.mjs",
    "db:seed": "node scripts/db-sync.mjs --seed-only",
    "db:verify": "node scripts/db-verify.mjs",
    "db:remote:schema": "supabase db query --linked -f supabase/schema.sql",
    "db:remote:seed": "supabase db query --linked -f supabase/seed_mock_demo.sql",
    "db:types": "mkdir -p src/types && supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "deploy:check-env": "node scripts/check-netlify-env.mjs",
    "deploy:check-env:production": "node scripts/check-netlify-env.mjs --production",
    "cron:smoke": "node scripts/cron-smoke.mjs",
    "cron:smoke:reminders-only": "node scripts/cron-smoke.mjs --skip-expire",
    "generate-secrets": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.9",
    "next": "16.2.4",
    "nodemailer": "^8.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pg": "^8.20.0",
    "supabase": "^2.93.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
