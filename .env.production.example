# Copia para `.env.production.local` (ficheiro ignorado pelo git) e ajusta.
# Serve para `npm run deploy:check-env:production` — sobrepõe variáveis do .env.local
# com os mesmos valores que vais pôr no Netlify, sem perderes localhost no dia-a-dia.
#
# Mínimo útil: URL pública com https
NEXT_PUBLIC_SITE_URL=https://casamento-rafael-adrielly.netlify.app
#
# Opcional: se quiseres validar outra senha de admin de produção sem alterar .env.local
# ADMIN_PASSWORD=
